{
  "name": "Méhecske Global Discovery Beacon",
  "description": "Local verification of operator-approved fixed synthetic benchmarks. Participation is free and requires operator-approved Ed25519 authentication for A2A requests.",
  "version": "0.1.0",
  "supportedInterfaces": [
    {
      "url": "https://45.134.38.53/a2a/v1",
      "protocolBinding": "JSONRPC",
      "protocolVersion": "1.0"
    }
  ],
  "capabilities": {
    "streaming": false,
    "pushNotifications": false,
    "extensions": [
      {
        "uri": "https://a2a-registry.org/extensions/registry/v1",
        "description": "A2A Global Registry verification and metadata extension",
        "required": false,
        "params": {
          "identity": {
            "provider": "github",
            "username": "raymondeu1974",
            "packageName": "github.raymondeu1974.mhecske_global_discovery_beacon"
          }
        }
      }
    ]
  },
  "securitySchemes": {
    "operatorSignature": {
      "apiKeySecurityScheme": {
        "location": "header",
        "name": "X-Mehecske-Signature",
        "description": "Operator-approved Ed25519 HTTP request signature."
      }
    }
  },
  "securityRequirements": [
    {
      "schemes": {
        "operatorSignature": {
          "list": []
        }
      }
    }
  ],
  "defaultInputModes": [
    "application/json"
  ],
  "defaultOutputModes": [
    "application/json"
  ],
  "skills": [
    {
      "id": "synthetic-shortest-path-v1",
      "name": "Count shortest paths",
      "description": "Compute distance and count shortest paths in a cyclic directed graph.",
      "tags": [
        "synthetic",
        "verification"
      ]
    }
  ]
}
